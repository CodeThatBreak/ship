# ── App ──────────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/devflow.db
WORKSPACE_DIR=~/agent-fleet/workspaces          # local clones used for diffs (cloud mode)
DEFAULT_MODEL=composer-2.5                      # optional Cursor model id, else account default

# Integration credentials (GitLab, Jira, Cursor) are NOT env-based — manage
# them in the UI: Settings → Integrations (Git / Task / Harness tabs). They
# are stored in the app database.
#
# Optional:
#   GITLAB_WEBHOOK_SECRET   — shared-secret check for /api/webhooks/gitlab
