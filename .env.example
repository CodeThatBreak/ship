# ── App ──────────────────────────────────────────────────────────────────────
# Postgres for `npm run dev` and `node scripts/seed-*.mjs` (default: the
# dockerized dev database from `npm run db:up`).
# Any Postgres works: point DATABASE_URL at it and run `npm run db:migrate`.
# In production (`next start`), leave DATABASE_URL unset to default to the
# dedicated `devflow_prod` database so seeded demo data never leaks.
# DATABASE_URL=postgresql://devflow:devflow@localhost:5432/devflow
WORKSPACE_DIR=~/agent-fleet/workspaces          # local clones used for diffs (cloud mode)
DEFAULT_MODEL=composer-2.5                      # optional Cursor model id, else account default

# Integration credentials (GitLab, Jira, Cursor) are NOT env-based — manage
# them in the UI: Settings → Integrations (Git / Task / Harness tabs). They
# are stored in the app database.
#
# Optional:
#   DEVFLOW_LOCAL_API_TOKEN        — 64-char hex local API token (middleware + UI); generate once and keep stable
#   DEVFLOW_SECRETS_KEY            — base64url-encoded 32-byte AES key for at-rest encryption (required in production)
#   GITLAB_WEBHOOK_SECRET          — GitLab `Secret token` for POST /api/webhooks/gitlab
#   GITLAB_WEBHOOK_ALLOW_UNSIGNED  — set to 1 to accept unsigned GitLab webhooks when secret unset (local dev only)
#   SERVER_PUBLIC_URL              — public base URL agents reach this server on; enables the agent self-repair
#                                    tools (step 08) — unset keeps the pre-step-08 prose-fence behavior
