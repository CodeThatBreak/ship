# ── App ──────────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/devflow.db
WORKSPACE_DIR=./workspaces          # local clones used for diffs (cloud mode)
DEFAULT_MODEL=                      # optional Cursor model id, else account default

# Integration credentials (GitLab, Jira, Cursor) are NOT env-based anymore —
# manage them in the UI: Settings → Integrations (Git / Task / Harness tabs).
# They are stored in the app database.
#
# Optional back-compat values (not required):
#   CURSOR_API_KEY          — legacy fallback for the Cursor API key
#   GITLAB_WEBHOOK_SECRET   — shared-secret check for /api/webhooks/gitlab
