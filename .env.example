# ── Cursor Cloud Agents (powers plan / build / fix / review nodes in cloud mode) ─
# https://cursor.com/dashboard/api
CURSOR_API_KEY=

# ── Jira ─────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=            # e.g. https://jira.company.com  (self-hosted) or https://you.atlassian.net
JIRA_EMAIL=               # your Jira login email / username
JIRA_API_TOKEN=           # API token (Jira Cloud) or PAT (self-hosted)

# ── GitLab (self-hosted supported) ───────────────────────────────────────────
# Default instance — used for repos whose domain has no entry in Settings → GitLab instances.
# Multiple self-hosted domains: add them in the UI (Settings page), one per domain.
GITLAB_BASE_URL=          # e.g. https://gitlab.company.com
GITLAB_TOKEN=             # PAT with api scope
GITLAB_WEBHOOK_SECRET=    # shared secret for /api/webhooks/gitlab

# ── App ──────────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/devflow.db
WORKSPACE_DIR=./workspaces          # local clones used for diffs (cloud mode)
DEFAULT_MODEL=                      # optional Cursor model id, else account default
