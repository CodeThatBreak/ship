{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "outDir": "../node_modules/.cache/promptparity",
    "rootDir": ".."
  },
  "include": [
    "verify-prompt-parity.ts",
    "../global.d.ts"
  ]
}
